# Database
POSTGRES_DB=calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=change-me
CALENDAR_DATABASE_URL=postgresql+asyncpg://calendar:change-me@db:5432/calendar

# Application
CALENDAR_ENVIRONMENT=development
CALENDAR_USER_TIMEZONE=Asia/Shanghai
CALENDAR_SESSION_SECRET=replace-with-at-least-32-random-characters
CALENDAR_ICS_TOKEN=replace-with-a-random-private-token
CALENDAR_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000

# Shared secret gate for the API. Required on every API route except /health,
# /ready and /calendar/*. The Next.js proxy attaches it; browsers never see it.
# Leave empty to disable the gate (local development, unit tests). The same
# value must be set as the INTERNAL_API_SECRET secret on the Cloudflare Worker.
INTERNAL_API_SECRET=

# Optional when the API hostname is protected by Cloudflare Access
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional notifications
CALENDAR_FEISHU_WEBHOOK_URL=

# Optional third-party earnings discovery (keep this server-side only)
FINNHUB_API_KEY=

# Optional automatic calendar translation (backend only; free personal key)
CALENDAR_AGNES_API_KEY=
CALENDAR_AGNES_MODEL=agnes-2.5-flash

# Production only
CALENDAR_DOMAIN=calendar.example.com
CALENDAR_ADMIN_PASSWORD_HASH=
